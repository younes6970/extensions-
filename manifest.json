{
  "manifest_version": 3,
  "name": "MySpace — New Tab Dashboard",
  "description": "Futuristic new tab with 3 themes, Persian/English, calendars, crypto market and football standings.",
  "version": "2.2.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://site.api.espn.com/*"
  ]
}