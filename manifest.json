{
  "manifest_version": 3,
  "name": "MySpace — New Tab Dashboard",
  "description": "Personal desktop-style new tab OS with installed website shortcuts, window manager, local file picker and legacy dashboard apps.",
  "version": "3.3.1",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://site.api.espn.com/*"
  ]
}